# ============================================================================
# VARIABLES DE ENTORNO - SISTEMA ODONTOLÓGICO PARAGUAY
# ============================================================================
# Copiar este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
# ADVERTENCIA: NUNCA commitear claves reales o secretos al repositorio Git.
# ============================================================================

# ENTORNO Y URLs
NODE_ENV="development"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# BASE DE DATOS (PostgreSQL 16+ / Neon / Supabase)
# DATABASE_URL: Conexión con Connection Pooling (PgBouncer) para operaciones de la app
DATABASE_URL="postgresql://usuario:password@pooler.neon.tech/clinica_db?sslmode=require"
# DIRECT_URL: Conexión directa para ejecutar migraciones Drizzle / Prisma
DIRECT_URL="postgresql://usuario:password@ep-direct.neon.tech/clinica_db?sslmode=require"

# AUTENTICACIÓN Y SEGURIDAD
# Generar una clave secreta segura en terminal: openssl rand -base64 32
AUTH_SECRET="tu_clave_secreta_minimo_32_caracteres_aleatorios"
NEXTAUTH_URL="http://localhost:3000"
SESSION_EXPIRATION_HOURS="8"

# CONFIGURACIÓN REGIONAL DE PARAGUAY (POR DEFECTO)
DEFAULT_COUNTRY_CODE="PRY"
DEFAULT_CURRENCY="PYG"
DEFAULT_TIMEZONE="America/Asuncion"
DEFAULT_LOCALE="es-PY"

# ALMACENAMIENTO DE RADIOGRAFÍAS Y DOCUMENTOS MÉDICOS (S3 Compatible / Cloudflare R2 / Supabase Storage)
STORAGE_ENDPOINT="https://tu-cuenta.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID=""
STORAGE_SECRET_ACCESS_KEY=""
STORAGE_BUCKET_NAME="clinica-odontologica-archivos"

# SERVICIOS DE IA (Google Gemini API - Para futuras funciones de asistencia clínica)
GEMINI_API_KEY="TU_GEMINI_API_KEY"

# ============================================================================
# PARAGUAY: FACTURACIÓN ELECTRÓNICA SIFEN / e-Kuatia (SET / DNIT)
# ============================================================================
SIFEN_ENV="test" # "test" para homologación, "prod" para producción oficial
SIFEN_CERT_PATH="/certs/certificado_firma_digital.p12"
SIFEN_CERT_PASSWORD="tu_password_certificado"
SIFEN_CSC="00000000-0000-0000-0000-000000000000" # Código de Seguridad del Contribuyente
SIFEN_CSC_ID="0001"

# ============================================================================
# PARAGUAY: PASARELA DE PAGOS BANCARD (QR & TARJETAS)
# ============================================================================
BANCARD_ENVIRONMENT="staging" # "staging" o "production"
BANCARD_PUBLIC_KEY="tu_bancard_public_key"
BANCARD_PRIVATE_KEY="tu_bancard_private_key"
BANCARD_COMMERCE_CODE="123456"

# ============================================================================
# CONFIGURACIÓN VERCEL PRODUCTION
# ============================================================================
VERCEL_ENV="production"
VERCEL_REGION="gru1" # São Paulo, Brasil (menor latencia a Asunción: ~28ms)

