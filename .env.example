# ============================================================================
# SISTEMA DE GESTIÓN ODONTOLÓGICA - VARIABLES DE ENTORNO (.env.example)
# ============================================================================
# Copiar este archivo a .env.local para desarrollo local:
#   cp .env.example .env.local
# ADVERTENCIA: NUNCA commitear archivos .env reales ni claves secretas al repositorio Git.
# ============================================================================

# ENTORNO Y URLs
NODE_ENV="development"
VITE_APP_URL="http://localhost:3000"

# AUTENTICACIÓN, SESIONES Y SEGURIDAD
VITE_SESSION_EXPIRATION_HOURS="8"
VITE_MAX_LOGIN_ATTEMPTS="5"
VITE_LOCKOUT_DURATION_MINUTES="15"
# Clave de cifrado simétrico para tokens de servidor (generar con: openssl rand -base64 32)
AUTH_SECRET="tu_clave_secreta_minimo_32_caracteres_aleatorios_aqui"

# CONFIGURACIÓN REGIONAL POR DEFECTO (PARAGUAY)
VITE_DEFAULT_COUNTRY_CODE="PRY"
VITE_DEFAULT_CURRENCY="PYG"
VITE_DEFAULT_CURRENCY_SYMBOL="₲"
VITE_DEFAULT_TIMEZONE="America/Asuncion"
VITE_DEFAULT_LOCALE="es-PY"

# BRANDING INICIAL CONFIGURABLE
VITE_DEFAULT_TRADE_NAME="OdontoPro Paraguay"
VITE_DEFAULT_PRIMARY_COLOR="teal"

# BASE DE DATOS (PostgreSQL 16+ / Neon / Cloud SQL)
DATABASE_URL="postgresql://usuario:password_ficticio@host.ejemplo.com/odontologia_db?sslmode=require"
DIRECT_URL="postgresql://usuario:password_ficticio@host-direct.ejemplo.com/odontologia_db?sslmode=require"

# ALMACENAMIENTO DE ARCHIVOS Y RADIOGRAFÍAS (S3 / R2 / Cloud Storage)
STORAGE_ENDPOINT="https://ejemplo-cuenta.r2.cloudflarestorage.com"
STORAGE_ACCESS_KEY_ID="identificador_ficticio_storage"
STORAGE_SECRET_ACCESS_KEY="secreto_ficticio_storage"
STORAGE_BUCKET_NAME="clinica-odontologica-archivos"

# SERVICIOS DE FACTURACIÓN ELECTRÓNICA (DNIT / SIFEN PARAGUAY - Modo Pruebas)
SIFEN_ENV="test"
SIFEN_CERT_PATH="/certs/certificado_firma_digital.p12"
SIFEN_CERT_PASSWORD="password_certificado_ficticio"
SIFEN_CSC="00000000-0000-0000-0000-000000000000"
SIFEN_CSC_ID="0001"

# PASARELA DE COBROS BANCARD PARAGUAY (Staging)
BANCARD_ENVIRONMENT="staging"
BANCARD_PUBLIC_KEY="clave_publica_bancard_ficticia"
BANCARD_PRIVATE_KEY="clave_privada_bancard_ficticia"
BANCARD_COMMERCE_CODE="123456"
